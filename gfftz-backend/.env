# ============================================
# Go 环境配置
# ============================================
export GOPROXY=https://goproxy.cn,direct
export GOSUMDB=sum.golang.google.cn
export GO111MODULE=on

# ============================================
# 应用环境配置
# ============================================
# 环境选择: dev (开发) | test (测试) | prod (生产)
export GFFTZ_ENV=dev

# ============================================
# 可选：覆盖配置文件中的设置
# ============================================
# 服务器端口
# export GFFTZ_SERVER_PORT=6300

# 数据库配置
# export GFFTZ_DATABASE_MYSQL_ADDR=localhost:3306
# export GFFTZ_DATABASE_MYSQL_USER=root
# export GFFTZ_DATABASE_MYSQL_PASSWORD=your_password
# export GFFTZ_DATABASE_MYSQL_DB_NAME=gfftz

# JWT 配置
# export GFFTZ_JWT_SECRET=your_secret_key
# export GFFTZ_JWT_ACCESS_EXPIRES_IN=15m
# export GFFTZ_JWT_REFRESH_EXPIRES_IN=7d

# 日志配置
# export GFFTZ_LOGGER_LEVEL=info
# export GFFTZ_LOGGER_FILENAME=log/app.log